# Server-only key: address, parcel, land register, building WFS
VWORLD_API_KEY=
# Optional: exact service URL registered with the server key (e.g. https://your-app.vercel.app)
VWORLD_DOMAIN=
# Public, domain-restricted WMTS key; exposed in browser, separate from server key
VITE_VWORLD_MAP_KEY=

# Existing trial access control (server only; keep the values already configured in Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=
ADMIN_SECRET=
APP_ORIGIN=
