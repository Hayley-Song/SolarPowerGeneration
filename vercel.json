{
  "functions": {
    "api/site-area.ts": {
      "maxDuration": 45,
      "regions": ["icn1"]
    }
  },
  "installCommand": "pnpm install --no-frozen-lockfile",
  "headers": [
    {
      "source": "/trial/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin"
        }
      ]
    }
  ]
}